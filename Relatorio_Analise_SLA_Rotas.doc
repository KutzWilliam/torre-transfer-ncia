        <tr><td>110</td><td>Jaguariaiva</td><td>JAGUARIAIVA X PONTA GROSSA X CURITIBA</td><td>JGV</td><td>0 viagens de transferência com origem em Jaguariaíva.</td></tr>
        <tr><td>112</td><td>Joaçaba</td><td>JOAÇABA X JOINVILLE</td><td>JCB</td><td>0 viagens saindo de Joaçaba. A linha opera como Joinville x Joaçaba.</td></tr>
