            <th class="text-center">SLA (%)</th>
            <th class="text-center">Atraso Médio</th>
            <th>Causa Raiz Comprovada nas Fontes</th>
            <th>Ação Recomendada (Revisão da Malha EE2)</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><strong>CURITIBA X APUCARANA X LONDRINA</strong></td>
            <td class="text-center">94</td>
            <td class="text-center">2</td>
            <td class="text-center"><span class="badge badge-red">2,1%</span></td>
